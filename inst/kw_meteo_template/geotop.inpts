LWinParameterization	=	4 
MoninObukhov	=	4
CanopyStabCorrection	=	1 
ThresMinWindSpeed=1
!======================================= 
! SNOW AND GLACIERS 
!======================================= 
 
MaxWaterEqSnowLayerContent=10
SWEtop=40
SWEbottom=20
MaxSnowLayersMiddle=5

InitGlacierDensity = 700
InitGlacierTemp = -5

!MaxWaterEqGlacLayerContent=50
!GWEtop=300
!GWEbottom=100
