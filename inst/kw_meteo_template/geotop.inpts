!!!0.50
!!0.65

!*******************************
!*********** SNOW *************
!*******************************
!!-- Wani et al,2021 appendix 1 Table A1: Snow characterisation parameters used as input to the GEOtop model
!!-- https://tc.copernicus.org/articles/15/2273/2021/tc-15-2273-2021-supplement.pdf
!!-- ref: The Cryosphere, 15, 2273–2293, 2021, https://doi.org/10.5194/tc-15-2273-2021

MaxWaterEqSnowLayerContent = 7
SWEtop = 3000
SWEbottom = 3000
MaxSnowLayersMiddle = 50

!!-- Wani appendix 1 Table A2 Snow characterisation parameters used as input to the GEOtop mode The parameter values were adopted from Gubler et al. (2013) and Engel et al. (2017).
!!-- https://tc.copernicus.org/articles/15/2273/2021/tc-15-2273-2021-supplement.pdf

SnowCorrFactor = 1.0
!!1.8
RainCorrFactor = 1.0 
DewTempOrNormTemp = 0
ThresTempRain = 3
ThresTempSnow = -1
SnowEmissiv = 0.98
IrriducibleWatSatSnow = 0.07
MaxSnowPorosity = 0.7
DrySnowDefRate = 1
SnowDensityCutoff = 175
WetSnowDefRate = 1.5 
SnowViscosity = 6.0e6
AlphaSnow = 1.0e5
FreshSnowReflVis = 0.85
FreshSnowReflNIR = 0.65
AlbExtParSnow = 10
SnowRoughness = 2
SnowAgingCoeffVis = 0.2
SnowAgingCoeffNIR = 0.5









InitSWE=0
InitSnowDensity=250.0
InitSnowTemp=0
InitSnowAge=0



!FetchUp=100
!FetchDown=1000
!SnowSMIN=30
!SnowSMAX=80
!SnowCURV= -200



!=======================================
! CHANNELS
!=======================================

RatioChannelWidthPixelWidth	=	0.1
! in [mm]
ChannelDepression	=	2000

ThresWaterDepthLandInf = 5
ThresWaterDepthLandSup = 50
SurFlowResChannel = 20
ThresWaterDepthChannel = 100

!======================================= 
!Numerical parameters 
!======================================= 
 
RichardTol	=	1.E-3
MinLambdaWater = 1.E-8 
RichardMaxIter	=	500 
ExitMinLambdaWater = 1
UpdateHydraulicConductivity = 0
MinRatioKactualToKSat = 1E-8

MaxTimesHalvingTimeStepWater = 20 
MaxCourantSupFlowLand	=	0.1 
MaxCourantSupFlowChannel	=	0.1
MinSupWaterDepthLand	=	1 
MinSupWaterDepthChannel	=	1 
MinDiffSupWaterDepthLandChannel = 5

MinTimeStep = 0.1
MinTimeStepSupFlow	=	0.001

HeatEqTol	=	1.E-4 
!!HeatEqMaxIter	=	200 see below EC 20200831
HeatEqMaxIter	=	500 
MaxTimesHalvingTimeStepEnergy = 5 
CanopyMaxIter	=	3 
BusingerMaxIter	=	3 
TsMaxIter	=	3 
LocMaxIter	=	3 

! Morphological parameters
SlopeWeight = 1 
CurvatureWeight = 100
NumLowPassFilterOnDemForAll	=	2
NumLowPassFilterOnDemForCurv	=	20

