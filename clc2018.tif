es","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Ftechnical-library","@type":"Document","description":"Technical library of the Copernicus Land Monitoring Service.","effective":"2021-10-01T07:10:00+00:00","getRemoteUrl":null,"image_field":"","image_scales":null,"review_state":"published","title":"Technical library","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Ffaq","@type":"Document","description":"Check FAQ section on the website of the Copernicus Land Monitoring Service.","effective":"2021-09-20T13:49:00+00:00","getRemoteUrl":null,"image_field":"","image_scales":null,"review_state":"published","title":"FAQ","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fabout","@type":"Document","description":"Read about Copernicus Land Monitoring Service.","effective":"2021-09-16T08:19:00+00:00","getRemoteUrl":null,"image_field":"","image_scales":null,"review_state":"published","title":"About","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fwork-opportunities","@type":"Document","description":"Work opportunities in the Copernicus Land Monitoring Service.","effective":"2021-09-06T05:43:00+00:00","getRemoteUrl":null,"image_field":"","image_scales":null,"review_state":"published","title":"Work opportunities","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fpersonal-data-protection","@type":"Document","description":"Read how the Copernicus Land Monitoring Service handles personal data.","effective":"2021-07-12T06:49:55+00:00","getRemoteUrl":null,"image_field":"","image_scales":null,"review_state":"published","title":"Personal data protection","type_title":"Page"},{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fdata-policy","@type":"Document","description":"Check the Data policy of the Copernicus Land Monitoring Service.","effective":"2021-07-12T06:49:58+00:00","getRemoteUrl":null,"image_field":