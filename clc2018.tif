lone","type_title":"Plone Site"},"previous_item":{},"review_state":"published","rights":null,"subjects":[],"title":"Copernicus Land Monitoring Service","type_title":"Language Root Folder","version":"current","working_copy":null,"working_copy_of":null}},"siblings":{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@siblings"},"translations":{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@translations","items":[],"root":{"bg":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fbg","bs":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fbs","cs":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fcs","da":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fda","de":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fde","en":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen","es":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fes","et":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fet","fi":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Ffi","fr":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Ffr","hr":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fhr","hu":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fhu","it":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fit","lt":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Flt","lv":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Flv","mt":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fmt","nl":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fnl","pl":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fpl","pt":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fpt","ro":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fro","sk":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fsk","sl":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fsl","sv":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fsv"}},"types":{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@types"},"workflow":{"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@workflow"}},"@id":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018","@type":"DataSet","UID":"0407d497d3c44bcd93ce8fd5bf78596a","accessAndUseConstraints":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cp\u003EAccess to data is based on a principle of full, open and free access as established by the Copernicus data and information policy Regulation (EU) No 1159\u002F2013 of 12 July 2013. This regulation establishes registration and licensing conditions for GMES\u002FCopernicus users.\n\nFree, full and open access to this data set is made on the conditions that:\n\n1. When distributing or communicating Copernicus dedicated data and Copernicus service information to the public, users shall inform the public of the source of that data and information.\n\n2. Users shall make sure not to convey the impression to the public that the user's activities are officially endorsed by the Union.\n\n3. Where that data or information has been adapted or modified, the user shall clearly state this.\n\n4. The data remain the sole property of the European Union. Any information and data produced in the framework of the action shall be the sole property of the European Union. Any communication and publication by the beneficiary shall acknowledge that the data were produced “with funding by the European Union”.\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf-8"},"accessAndUseLimitationPublic_line":"no limitations to public access","allow_discussion":false,"changeNote":"","character_set":"utf8","characteristics_platform":null,"characteristics_position_accuracy":"100 m or better","characteristics_projection":"EPSG:3035","characteristics_release_major_version":"V2020_20u1","characteristics_sensor":"Sentinel-1, Sentinel-2","characteristics_spatial_coverage":"Europe","characteristics_spatial_representation_type":{"title":null,"token":"Vector and Grid"},"characteristics_spatial_resolution":"25 ha\u002F100 m","characteristics_temporal_extent":"2017-2018","characteristics_temporal_usability":{"title":null,"token":"Archive with regular updates"},"characteristics_thematic_accuracy":"≥ 85%","characteristics_timeliness":"","characteristics_type":{"title":null,"token":"Satellite products"},"characteristics_update_frequency":{"title":null,"token":"6-yearly"},"citation":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EDOI (raster 100 m):\u003C\u002Fstrong\u003E \u003Ca href=\"https:\u002F\u002Fdoi.org\u002F10.2909\u002F960998c1-1870-4e82-8051-6485205ebbac\" rel=\"noopener noreferrer\" target=\"_blank\"\u003Ehttps:\u002F\u002Fdoi.org\u002F10.2909\u002F960998c1-1870-4e82-8051-6485205ebbac\u003C\u002Fa\u003E\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003EDOI (vector):\u003C\u002Fstrong\u003E \u003Ca href=\"https:\u002F\u002Fdoi.org\u002F10.2909\u002F71c95a07-e296-44fc-b22b-415f42acfdf0\" rel=\"noopener noreferrer\" target=\"_blank\"\u003Ehttps:\u002F\u002Fdoi.org\u002F10.2909\u002F71c95a07-e296-44fc-b22b-415f42acfdf0\u003C\u002Fa\u003E\u003C\u002Fli\u003E\u003C\u002Ful\u003E\u003Cp\u003E\u003C\u002Fp\u003E\u003Cp\u003EYou can find instructions on how to cite CLMS data in our \u003Ca href=\"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fdata-policy\"\u003EData policy\u003C\u002Fa\u003E section.\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf8"},"classificationTopicCategory":["environment","imageryBaseMapsEarthCover"],"conformityPass":{"title":"Not evaluated","token":"Null"},"conformitySpecification":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cp\u003ECommission Regulation (EU) No 1089\u002F2010 of 23 November 2010 implementing Directive 2007\u002F2\u002FEC of the European Parliament and of the Council as regards interoperability of spatial data sets and services\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf-8"},"contributors":[],"coordinateReferenceSystemList":["EPSG:3035"],"created":"2021-10-29T10:15:58+00:00","creators":["forsllud"],"dataResourceAbstract":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cp\u003ECorine Land Cover 2018 (CLC2018) is one of the Corine Land Cover (CLC) datasets produced within the frame the Copernicus Land Monitoring Service referring to land cover \u002F land use status of year 2018.\n\nCLC service has a long-time heritage (formerly known as \"CORINE Land Cover Programme\"), coordinated by the European Environment Agency (EEA). It provides consistent and thematically detailed information on land cover and land cover changes across Europe.\n\nCLC datasets are based on the classification of satellite images produced by the national teams of the participating countries - the EEA members and cooperating countries (EEA39). National CLC inventories are then further integrated into a seamless land cover map of Europe. The resulting European database relies on standard methodology and nomenclature with following base parameters: 44 classes in the hierarchical 3-level CLC nomenclature; minimum mapping unit (MMU) for status layers is 25 hectares; minimum width of linear elements is 100 metres. Change layers have higher resolution, i.e. minimum mapping unit (MMU) is 5 hectares for Land Cover Changes (LCC), and the minimum width of linear elements is 100 metres. The CLC service delivers important data sets supporting the implementation of key priority areas of the Environment Action Programmes of the European Union as e.g. protecting ecosystems, halting the loss of biological diversity, tracking the impacts of climate change, monitoring urban land take, assessing developments in agriculture or dealing with water resources directives. CLC belongs to the Pan-European component of the Copernicus Land Monitoring Service (https:\u002F\u002Fland.copernicus.eu\u002F), part of the European Copernicus Programme coordinated by the European Environment Agency, providing environmental information from a combination of air- and space-based observation systems and in-situ monitoring.\n\nAdditional information about CLC product description including mapping guides can be found at https:\u002F\u002Fland.copernicus.eu\u002Fuser-corner\u002Ftechnical-library\u002F. CLC class descriptions can be found at https:\u002F\u002Fland.copernicus.eu\u002Fuser-corner\u002Ftechnical-library\u002Fcorine-land-cover-nomenclature-guidelines\u002Fhtml\u002F.\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf-8"},"dataResourceType":"dataset","dataset_download_information":{"items":[{"@id":"1bda2fbd-3230-42ba-98cf-69c96ac063bc","full_format":"GDB","full_path":"H:\\Corine_Land_Cover\\Corine_Land_Cover\\Corine_Land_Cover(CLC)_2018\\CLC2018_Version_20\\Data\\data-master\\U2018_CLC2018_V2020_20u1_vector\\U2018_CLC2018_V2020_20u1.gdb","full_source":"EEA","name":"VECTOR"},{"@id":"7bcdf9d1-6ba0-4d4e-afa8-01451c7316cb","collection":"100 m","full_format":"Geotiff","full_path":"H:\\Corine_Land_Cover\\Corine_Land_Cover\\Corine_Land_Cover(CLC)_2018\\CLC2018_Version_20\\Data\\data-master\\U2018_CLC2018_V2020_20u1_raster100m_tiled","full_source":"EEA","name":"RASTER"}]},"datasets":[],"date_stamp":"2023-08-15T13:38:42.642Z","description":"Provides pan-European CORINE Land Cover inventory for 44 thematic classes for the 2018 reference year. The dataset  has a Minimum Mapping Unit (MMU) of 25 hectares (ha) for areal phenomena and a Minimum Mapping Width (MMW) of 100 m for linear phenomena and is available as vector and as 100 m raster data.","distributionInfo":{"items":[{"@id":"distributionInfo0","resourceLocator":"https:\u002F\u002Fland.copernicus.eu\u002Fpan-european\u002Fcorine-land-cover\u002Fclc2018","services":"WWW:LINK-1.0-http--link"},{"@id":"distributionInfo1","resourceLocator":"https:\u002F\u002Fimage.discomap.eea.europa.eu\u002Farcgis\u002Frest\u002Fservices\u002FCorine\u002FCLC2018_WM\u002FMapServer","services":"ESRI:REST"},{"@id":"distributionInfo1","resourceLocator":"https:\u002F\u002Fimage.discomap.eea.europa.eu\u002Farcgis\u002Frest\u002Fservices\u002FCorine\u002FCLC2018_WM\u002FMapServer","services":"ESRI:REST"},{"@id":"distributionInfo1","resourceLocator":"https:\u002F\u002Fimage.discomap.eea.europa.eu\u002Farcgis\u002Frest\u002Fservices\u002FCorine\u002FCLC2018_WM\u002FMapServer","services":"ESRI:REST"},{"@id":"distributionInfo1","resourceLocator":"https:\u002F\u002Fimage.discomap.eea.europa.eu\u002Farcgis\u002Frest\u002Fservices\u002FCorine\u002FCLC2018_WM\u002FMapServer","services":"ESRI:REST"}]},"distribution_format_list":["GeoTIFF"],"download_by_area_extra_text":null,"download_full_dataset_text":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cp\u003EYou can download the full dataset as pre-packaged data collections. Click \u003Ca href=\"https:\u002F\u002Feea.github.io\u002Fclms-api-docs\u002Fdownload.html#full-dataset-downloads\" rel=\"noopener noreferrer\" target=\"_blank\"\u003Ehere\u003C\u002Fa\u003E to learn more about the CLMS download API.\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf8"},"download_grid_image_for_prepackages":null,"download_limit_temporal_extent":null,"download_mapviewer_message":"","download_other_ways_access_dataset":null,"download_page_information":{"content-type":"text\u002Fhtml","data":"\u003Chtml\u003E\u003Cbody\u003E\u003Cp\u003EPre-packaged Corine Land Cover 2018 datastes in their full coverage can be downloaded in raster (100 m resolution) and vector (ESRI and SQLite geodatabase) formats.\u003C\u002Fp\u003E\u003C\u002Fbody\u003E\u003C\u002Fhtml\u003E","encoding":"utf8"},"download_show_auxiliary_calendar":false,"download_table_area_of_interest_title":"Coverage","downloadable_dataset":true,"downloadable_files":{"items":[{"@id":"3d9e2413-46ca-4f6e-abf8-b6eb429a4e48","area":"Europe","file":"u2018_clc2018_v2020_20u1_raster100m","format":"Geotiff","path":"H:\\Corine_Land_Cover\\Corine_Land_Cover\\Corine_Land_Cover(CLC)_2018\\CLC2018_Version_20\\Data\\data-details\\raster\\u2018_clc2018_v2020_20u1_raster100m.zip","resolution":"100 m","size":"125 MB","source":"EEA","title":"","type":"Raster","version":"v2020_20u1","year":""},{"@id":"3bfb1a41-8b59-425d-b172-bd44517adbca","area":"Europe","file":"u2018_clc2018_v2020_20u1_fgdb","format":"GDB","path":"H:\\Corine_Land_Cover\\Corine_Land_Cover\\Corine_Land_Cover(CLC)_2018\\CLC2018_Version_20\\Data\\data-details\\vector\\gdb\\u2018_clc2018_v2020_20u1_fgdb.zip","resolution":"","size":"5 GB","source":"EEA","title":"","type":"Vector","version":"v2020_20u1","year":""},{"@id":"71a52224-0b24-4ecf-804c-a676c0017922","area":"Europe","file":"u2018_clc2018_v2020_20u1_geoPackage","format":"GPKG","path":"H:\\Corine_Land_Cover\\Corine_Land_Cover\\Corine_Land_Cover(CLC)_2018\\CLC2018_Version_20\\Data\\data-details\\vector\\gpkg\\u2018_clc2018_v2020_20u1_geoPackage.zip","resolution":"","size":"4 GB","source":"EEA","title":"","type":"Vector","version":"v2020_20u1","year":""}],"schema":{"dependencies":{},"fieldsets":[{"fields":["title","area","year","version","resolution","type","format","size","file","path","source"],"id":"default","title":"File"}],"properties":{"area":{"description":"Enter the area of this file.","title":"Area of interest","type":"string"},"file":{"description":"Enter the file name.","title":"File","type":"string"},"format":{"description":"Enter the format of this file.","title":"Format","type":"string"},"path":{"description":"Enter the absolute path of this file in the storage","title":"Path","type":"string"},"resolution":{"description":"Enter the resolution of this file. Ex: 100m","title":"Resolution","type":"string"},"size":{"description":"Enter the size of this file. Ex: 3.5GB","title":"Size","type":"string"},"source":{"choices":[["EEA","EEA"],["HOTSPOTS","HOTSPOTS"]],"enum":["EEA","HOTSPOTS"],"title":"Source","type":"string"},"title":{"description":"Enter the title of this file.","title":"Title","type":"string"},"type":{"choices":[["Raster","Raster"],["Vector","Vector"]],"enum":["Raster","Vector"],"title":"Type","type":"string"},"version":{"description":"Enter the version of this file.","title":"Version","type":"string"},"year":{"description":"Enter the year of this file.","exclusiveMinimum":null,"minimum":1900,"title":"Year","type":"number"}},"required":[],"title":"Downloadable File","type":"object"},"uiSchema":{"ui:order":["title","area","year","version","resolution","type","format","size","file","path","source"]}},"downloadable_full_dataset":true,"effective":"2019-06-13T21:00:00+00:00","exclude_from_nav":false,"expires":null,"familyTitle":null,"gemet":["land cover","landscape","landscape alteration","land","land use"],"gemetInspireThemes":["Land cover"],"geographicBoundingBox":{"items":[{"@id":"geographicBoundingBox0","east":"44.820775","north":"71.409109","south":"27.405827","west":"-31.561261"}]},"geographicCoverage":["EEA39"],"geonetwork_identifiers":{"items":[{"@id":"0e8c8262-db21-4729-9ca1-98e817577056","id":"960998c1-1870-4e82-8051-6485205ebbac","title":"CORINE Land Cover 2018 (raster 100 m), Europe, 6-yearly","type":"EEA"},{"@id":"f716ac9e-d81a-4b66-8875-eeaf21001200","id":"71c95a07-e296-44fc-b22b-415f42acfdf0","title":"CORINE Land Cover 2018 (vector), Europe, 6-yearly","type":"EEA"}]},"hierarchy_level":"dataset","id":"clc2018","identifier":"960998c1-1870-4e82-8051-6485205ebbac","image":{"content-type":"image\u002Fpng","download":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@@images\u002Fimage-400-4520e12cd5b63ffb876dea9038222103.png","filename":"CLC2018.png","height":400,"scales":{"big":{"download":"http:\u002F\u002Fbackend:8080\u002FPlone\u002Fen\u002Fproducts\u002Fcorine-land-cover\u002Fclc2018\u002F@@images\u002Fimage-80-d22de38f12e9e2a64